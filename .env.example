# Copy this file to .env and set your API key.

# --- LLM (OpenAI-compatible: OpenAI, Together, Groq, local servers, ...) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-nano-2026-03-17

# Set false to skip the reranker (saves ~2.4 GB RAM on small machines).
RERANK_ENABLED=true
