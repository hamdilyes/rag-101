# ============================================================================
#  RAG-101 environment configuration
#  Copy this file to .env (it is git-ignored) and fill in your values.
# ============================================================================

# ---- LLM provider (provider-agnostic) -------------------------------------
# Default is Anthropic Claude. To use any other provider, set LLM_PROVIDER to
# "openai" and point LLM_BASE_URL at any OpenAI-compatible /chat/completions
# endpoint (OpenAI, Together, Groq, Mistral, a local llama.cpp/vLLM server...).

LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# Most capable current model. See backend/src/llm.py for alternatives.
LLM_MODEL=claude-opus-4-8

# --- OpenAI-compatible (used when LLM_PROVIDER=openai) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---- Retrieval knobs ------------------------------------------------------
RETRIEVE_TOP_K=20        # candidates pulled by vector search
RERANK_TOP_N=5           # candidates kept after the reranker
RERANK_ENABLED=true      # set false to skip the (heavier) reranker

# ---- Models (HuggingFace ids) ---------------------------------------------
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# ---- Paths ----------------------------------------------------------------
INDEX_DIR=./data/index

# ---- Server ---------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
